---
import "../styles/global.css";
import { asset, client, content, safeColor } from "../data/site";

interface Props { title?: string; description?: string }
const { title = content.seo.title, description = content.seo.description } = Astro.props;
const canonical = client.canonical || undefined;
const ogImagePath = client.assets?.og || client.assets?.heroDesktop;
const ogImage = ogImagePath && canonical ? new URL(ogImagePath.replace(/^\//, ""), `${canonical}/`).toString() : asset(ogImagePath);
const primary = safeColor(content.brand?.primary, "#164e63");
const accent = safeColor(content.brand?.accent, "#0f766e");
---
<!doctype html>
<html lang="pt-BR" style={`--sage-dark:${primary};--sage:${accent};--terracotta:${accent};--terracotta-deep:${primary}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {client.assets?.logo && <link rel="icon" href={asset(client.assets.logo)} />}
    <meta name="theme-color" content={primary} />
    <meta name="robots" content={client.robots} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={content.seo.ogTitle || title} />
    <meta property="og:description" content={content.seo.ogDescription || description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
