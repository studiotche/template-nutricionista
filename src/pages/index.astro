---
import BaseLayout from "../layouts/BaseLayout.astro";
import { asset, business, client, content, differentiators, faqs, locationText, primaryContactUrl, reviews, services, telephoneUrl, whatsappUrl } from "../data/site";

const hasContact = Boolean(primaryContactUrl);
const heroDesktop = asset(client.assets?.heroDesktop);
const heroMobile = asset(client.assets?.heroMobile || client.assets?.heroDesktop);
const aboutImage = asset(client.assets?.about);
const logo = asset(client.assets?.logo);
const ctaLabel = content.hero.primaryCta?.label || "Entrar em contato";
---
<BaseLayout>
  <Fragment slot="head">
    {heroDesktop && <link rel="preload" as="image" href={heroDesktop} media="(min-width: 761px)" fetchpriority="high" />}
    {heroMobile && <link rel="preload" as="image" href={heroMobile} media="(max-width: 760px)" />}
    {client.jsonLd.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#inicio" aria-label={`${business.name}, início`}>
        {logo ? <img src={logo} alt={business.name} width="205" height="65" /> : <strong>{business.name}</strong>}
      </a>
      <nav class="desktop-nav" aria-label="Navegação principal">
        {content.about && <a href="#sobre">Sobre</a>}
        {services.length > 0 && <a href="#servicos">Serviços</a>}
        {reviews.length > 0 && <a href="#avaliacoes">Avaliações</a>}
        {faqs.length > 0 && <a href="#duvidas">Dúvidas</a>}
      </nav>
      {hasContact && <a class="button button-small" href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">{ctaLabel}</a>}
      <button class="hamburger" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Abrir menu"><span></span><span></span><span></span></button>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu-backdrop" data-close-menu></div>
    <div class="mobile-menu-panel">
      <button class="menu-close" type="button" data-close-menu aria-label="Fechar menu"><span aria-hidden="true">×</span></button>
      <div class="menu-panel-head"><span class="menu-brand">{business.name}</span>{business.category && <small class="kicker">{business.category}</small>}</div>
      <nav class="mobile-nav" aria-label="Navegação móvel">
        {content.about && <a href="#sobre">Sobre</a>}
        {services.length > 0 && <a href="#servicos">Serviços</a>}
        {reviews.length > 0 && <a href="#avaliacoes">Avaliações</a>}
        {faqs.length > 0 && <a href="#duvidas">Dúvidas</a>}
      </nav>
      {hasContact && <a class="button menu-cta" href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">{ctaLabel} <span aria-hidden="true">↗</span></a>}
    </div>
  </div>

  <main id="conteudo">
    <section class:list={["hero", !heroDesktop && "hero-without-image"]} id="inicio">
      {heroDesktop && <div class="hero-visual"><picture class="hero-bg"><source media="(max-width: 760px)" srcset={heroMobile} /><img src={heroDesktop} alt={content.media?.heroAlt || ""} width="1717" height="916" fetchpriority="high" /></picture></div>}
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="container hero-copy">
        {content.hero.eyebrow && <p class="eyebrow eyebrow-light">{content.hero.eyebrow}</p>}
        <h1>{content.hero.title}</h1>
        <p class="lead">{content.hero.description}</p>
        {hasContact && <div class="hero-actions"><a class="button" href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">{ctaLabel} <span aria-hidden="true">↗</span></a></div>}
        {locationText && <div class="location-note"><span class="location-dot" aria-hidden="true"></span><span>{locationText}</span></div>}
      </div>
    </section>

    {differentiators.length > 0 && <section class="trust-strip" aria-label="Diferenciais"><div class="container trust-grid">{differentiators.map((item, index) => <p><span>{String(index + 1).padStart(2, "0")}</span> {item.title}</p>)}</div></section>}

    {services.length > 0 && <section class="section services-section" id="servicos"><div class="container"><div class="section-heading"><div><p class="eyebrow eyebrow-light">Serviços confirmados</p><h2>Como podemos ajudar</h2></div></div><div class="service-grid">{services.map((service, index) => <article class="service-card"><span class="service-number">{String(index + 1).padStart(2, "0")}</span><div><h3>{service.name}</h3><p>{service.description}</p></div>{hasContact && <a href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">Mais informações <span aria-hidden="true">↗</span></a>}</article>)}</div></div></section>}

    {content.about && <section class="section about-section" id="sobre"><div class:list={["container", "about-grid", !aboutImage && "about-grid-text-only"]}>{aboutImage && <div class="about-media"><div class="image-frame about-frame"><img src={aboutImage} alt={content.media?.aboutAlt || ""} width="1122" height="1402" loading="lazy" /></div></div>}<div class="about-copy"><p class="eyebrow eyebrow-light">Sobre</p><h2>{content.about.heading}</h2><p>{content.about.body}</p>{hasContact && <a class="text-link text-link-dark" href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">Conversar agora <span aria-hidden="true">↗</span></a>}</div></div></section>}

    {reviews.length > 0 && <section class="section testimonials-section" id="avaliacoes"><div class="container"><div class="testimonial-heading"><div><p class="eyebrow">Avaliações verificadas</p><h2>Experiências compartilhadas</h2></div></div><div class="testimonial-grid">{reviews.map((review) => <figure class="testimonial-card"><span class="quote-mark" aria-hidden="true">“</span><blockquote>{review.text}</blockquote><figcaption><strong>{review.author}</strong>{review.date && <time datetime={review.date}>{review.date}</time>}</figcaption></figure>)}</div></div></section>}

    {faqs.length > 0 && <section class="section faq-section" id="duvidas"><div class="container faq-grid"><div><p class="eyebrow">Dúvidas frequentes</p><h2>Respostas objetivas</h2></div><div class="faq-list">{faqs.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></div></section>}

    {(hasContact || locationText) && <section class="contact-section" id="contato"><div class="container contact-card"><div><p class="eyebrow eyebrow-light">Contato</p><h2>Fale com {business.name}</h2></div><div class="contact-details">{locationText && <p><span>Localização</span><strong>{locationText}</strong></p>}{business.phone && <p><span>Telefone</span><strong><a class="contact-tel" href={telephoneUrl}>{business.phone}</a></strong></p>}{business.email && <p><span>E-mail</span><strong><a href={`mailto:${business.email}`}>{business.email}</a></strong></p>}{hasContact && <a class="button button-light" href={primaryContactUrl} target={whatsappUrl ? "_blank" : undefined} rel="noreferrer">{ctaLabel} <span aria-hidden="true">↗</span></a>}</div></div></section>}
  </main>

  <footer class="site-footer"><div class="container footer-main logo">{logo ? <img src={logo} alt={business.name} width="205" height="65" /> : <strong>{business.name}</strong>}<p>{content.seo.description}</p><div class="footer-links">{business.phone && <a href={telephoneUrl}>{business.phone}</a>}<a href="#inicio">Voltar ao início ↑</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {business.name}</span><span class="footer-credit">Conteúdo revisado antes da publicação</span></div></footer>
  {whatsappUrl && <a class="floating-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label={`Falar com ${business.name} pelo WhatsApp`}><img src={asset("/images/whatsapp.webp")} alt="" width="34" height="34" /></a>}
</BaseLayout>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
  const menu = document.getElementById("mobileMenu");
  if (hamburger && menu) {
    const close = () => { menu.classList.remove("open"); menu.setAttribute("aria-hidden", "true"); hamburger.setAttribute("aria-expanded", "false"); document.body.classList.remove("menu-open"); };
    hamburger.addEventListener("click", () => { const opening = !menu.classList.contains("open"); menu.classList.toggle("open", opening); menu.setAttribute("aria-hidden", String(!opening)); hamburger.setAttribute("aria-expanded", String(opening)); document.body.classList.toggle("menu-open", opening); });
    menu.querySelectorAll("[data-close-menu], .mobile-nav a").forEach((element) => element.addEventListener("click", close));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") close(); });
  }
</script>
